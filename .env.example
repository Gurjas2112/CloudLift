# Copy to .env (git-ignored). Never commit real values.
CLOUDLIFT_DEVICE=auto            # auto | cpu | cuda
CLOUDLIFT_WEIGHTS=               # path to pretrained UnCRtainTS .pth.tar (empty = tiny untrained model)
CLOUDLIFT_DATA_ROOT=data/raw
CLOUDLIFT_RESULTS_ROOT=results
CLOUDLIFT_CACHE_ROOT=cache
# Optional Google Earth Engine (feature flag, off by default)
CLOUDLIFT_GEE_ENABLED=false
GEE_SERVICE_ACCOUNT=
GEE_KEY_FILE=
# Hugging Face token is read by the `hf` CLI from its own login, not from here.
